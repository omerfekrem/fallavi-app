# Bu dosyayı .env olarak kopyala: cp .env.example .env
# Değerleri takım arkadaşından güvenli bir kanaldan al (1Password, Bitwarden vb.)

# Google Cloud Console > Credentials > "Web client (auto created by Google Service)"
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# GoogleService-Info.plist içindeki REVERSED_CLIENT_ID
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.xxxxxxxx

# true => geliştirmede gerçek Firebase yerine yerel emülatör (kota harcamaz)
EXPO_PUBLIC_USE_FIREBASE_EMULATOR=true
# Android emülatörü için 10.0.2.2, fiziksel cihaz için bilgisayarın yerel IP'si
EXPO_PUBLIC_EMULATOR_HOST=localhost
